<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.pumluda.infrastructure.dao.ITradeOrderDao">

    <resultMap id="dataMap" type="TradeOrderPo">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="user_tag" property="userTag"/>
        <result column="order_status" property="orderStatus"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="pay_amount" property="payAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="entry_source" property="entrySource"/>
        <result column="pay_channel" property="payChannel"/>
        <result column="order_create_time" property="orderCreateTime"/>
        <result column="order_expire_time" property="orderExpireTime"/>
        <result column="order_end_time" property="orderEndTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="addTradeOrder" parameterType="TradeOrderPo">
        INSERT INTO group_buy_market_better.trade_order (order_no, user_id, user_tag, order_status, total_amount,
                                                         pay_amount, discount_amount, entry_source,
                                                         order_create_time, order_expire_time,
                                                         create_time, update_time)
        VALUES (#{orderNo},
                #{userId},
                #{userTag},
                #{orderStatus},
                #{totalAmount},
                #{payAmount},
                #{discountAmount},
                #{entrySource},
                #{orderCreateTime},
                #{orderExpireTime},
                now(),
                now())
    </insert>


    <select id="getOrderByOrderNo" parameterType="java.lang.String" resultType="TradeOrderPo">
        SELECT order_no,
               user_id,
               user_tag,
               order_status,
               total_amount,
               pay_amount,
               discount_amount,
               entry_source,
               pay_channel,
               order_create_time,
               order_expire_time,
               order_end_time,
               create_time,
               update_time
        FROM group_buy_market_better.trade_order
        WHERE order_no = #{orderNo}
    </select>
</mapper>